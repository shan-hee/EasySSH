# ============================================
# .dockerignore - Docker 构建上下文优化
# ============================================

# Git 相关
.git
.gitignore
.gitattributes
.github

# 文档
*.md
docs/
README.md
LICENSE
CHANGELOG.md

# Docker 镜像只需要 VERSION、根工作区配置、web、packages、tooling、server 和 shared；
# 桌面前端只保留包清单，用于按根锁文件安装 Web 依赖
desktop/
!desktop/EasySSHDesktop/frontend/package.json
docker/
scripts/

# IDE 和编辑器
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# 前端相关
node_modules
**/node_modules
web/.turbo
web/.eslintcache
web/dist
web/build
web/coverage
web/.env*.local

# 后端相关
server/tmp
server/vendor
server/api
server/bin
server/data
server/data1
server/backups
server/*.exe
server/*.dll
server/*.so
server/*.dylib
server/easyssh-api
server/.env*.local

# 测试和覆盖率
**/test
**/*_test.go
**/coverage
**/*.test
**/__tests__
**/__mocks__

# 日志文件
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 临时文件
tmp/
temp/
*.tmp
*.cache

# Docker 相关
docker/data
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/workflows
.gitlab-ci.yml
.travis.yml

# 数据和配置
data/
*.db
*.sqlite
*.sql

# 其他
.env
.env.local
.env.development
.env.test
.env.production

server/sync-runtime/node_modules

# Versioned SQL is application source required by go:embed.
!shared/dbmigration/**/*.sql
